# Browser.cash API Keys
# Agent API key (for autonomous scraping)
AGENT_API_KEY=your_agent_api_key_here
# Browser API key (for fallback scraping)
BROWSER_CASH_API_KEY=your_browser_cash_api_key_here
BROWSER_CASH_BASE_URL=https://api.browser.cash

# OpenAI API
OPENAI_KEY=your_openai_key_here

# GAMMA API
GAMMA_API_KEY=your_gamma_key_here

# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
